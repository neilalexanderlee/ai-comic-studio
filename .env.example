# App
DATABASE_URL=file:./data/aicomic.db
UPLOAD_DIR=./uploads

# 本地代理（可选）
# 填写后，Node.js 服务端所有 fetch 请求（含 @google/genai SDK）自动走此代理，
# 解决 googleapis.com 等境外 API 在国内服务端无法直连的问题。
# 须先安装依赖：pnpm add undici
#
# pnpm dev 本地开发（代理跑在本机）：
# HTTPS_PROXY=http://127.0.0.1:7897
#
# Docker 启动（代理跑在宿主机，容器需用 host.docker.internal）：
# HTTPS_PROXY=http://host.docker.internal:7897
#
# 端口换成你的 VPN 客户端（Clash Verge / ClashX 等）实际暴露的 HTTP 代理端口。

# 设为 1 时关闭：删 cookie 后把「单用户」库内项目自动归到当前浏览器 ID（本地无登录模式）
# AI_COMIC_DISABLE_LOCAL_RECLAIM=1

# 保存 API 密钥后：防抖生成完整 SQLite 快照到 data/backups/（与 DATABASE_URL 同目录）。设为 1 可关闭。
# AI_COMIC_DISABLE_DB_BACKUP=1

# 可选：设置后每次写入密钥会额外把 provider_secrets 加密写入 data/secrets-vault.enc.json（≥8 字符口令）
# AI_COMIC_SECRETS_VAULT_KEY=

# 「锁定到私域素材库」功能必需：火山方舟服务端需要一个公网可访问的地址来抓取角色定妆图。
# 填你部署本应用的公网域名（不要带末尾斜杠），如 https://your-domain.com。
# 未部署到公网域名（如纯本地开发）时，锁定到素材库会报错，其余功能不受影响。
# AI_COMIC_APP_PUBLIC_URL=

# Docker build (optional): Alpine apk mirror host.
# Used by `docker compose build` only, ignored by `pnpm dev`.
# Keep default official mirror unless your network is unstable.
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org

# ── 计费 / 积分（托管 SaaS 模式）────────────────────────────────────────────
# 默认关闭。自部署场景保持注释即可 —— 用户自带 API Key，不需要积分，
# 一旦开启且余额为 0，所有生成都会被 402 拦下。
# 仅当以托管服务运行（平台统一 Key + 向用户售卖积分）时才设为 1。
# BILLING_ENABLED=1

# ── 对象存储 OSS（可选）──────────────────────────────────────────────────────
# 四个变量**全部**配置后，新生成的产物写入 OSS（引用形态 oss://<key>）；
# 未配置则落本地磁盘，行为与接入前完全一致，存量文件继续可读。
# bucket 必须为**私有**：对外访问一律走服务端签发的签名 URL。
# OSS_REGION=oss-cn-beijing
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
#
# 服务端收发数据是否走 OSS 内网端点（oss-<region>-internal.aliyuncs.com）。
# 只有跑在**与 bucket 同地域**的阿里云 ECS 上才能开 —— 同地域内网流量不计费，
# 而公网出流量按量收费。一次剧集导出要拉几十个源片（实测一集 125MB），
# 走公网几次就能打穿流量包。
#
# ⚠️ 别处开了会直接连不上（内网域名在公网解析不到），不会静默降级。
# 签名 URL 不受影响：它们永远用公网端点，因为要给浏览器和上游模型服务用。
# OSS_INTERNAL=1

# ── 公网部署必设 ────────────────────────────────────────────────────────────
# 只认 HMAC 签名过的登录 cookie，不再接受 x-user-id 请求头和未签名的
# ai_comic_uid cookie 作为身份。
#
# ⚠️ 不设这个而把服务暴露到公网 = **完全没有认证**：
#     curl -H "x-user-id: <某人的 ULID>" http://你的站点/api/projects
#     → 200，返回那个人的全部项目
# 默认不设，是为了自部署用户在自己机器上不必先注册登录。
# REQUIRE_AUTH=1
#
# 关闭自助注册。只给自己用的公网实例应当设为 0，否则任何人都能开账号。
# ALLOW_REGISTRATION=0
#
# 登录 cookie 的签名密钥。**生产必须设**，否则回落到代码里的硬编码默认值 ——
# 而本项目是开源的，那个默认值全世界可见，等于任何人都能伪造登录态。
#   openssl rand -base64 48
# AUTH_SECRET=

# ── 本地开发：与服务器数据库的同步检查（scripts/db-dev-sync.sh）─────────────
# `pnpm dev` 启动前会比一次两边指纹。默认**只提示不覆盖** —— pull 是整库覆盖本地，
# 自动跑会悄悄吃掉你在 localhost 上的改动。
# DB_AUTO_PULL=1      # 本地自上次同步以来没改过时，自动拉取服务器数据
# DB_SYNC_DISABLE=1   # 完全跳过检查（离线工作时）；也可以直接用 pnpm dev:solo
# ECS_HOST=root@<server-ip-redacted>

{
  "name": "ai-comic-studio",
  "description": "AI漫剧工坊 — open-source workflow for manju (漫剧): script to storyboard, frames, and video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3007",
    "dev:clean": "lsof -ti:3007 | xargs kill -9 2>/dev/null || true; rm -rf .next && next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "eslint",
    "pdf:intro": "node scripts/print-intro-pdf.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx src/lib/evals/index.ts",
    "prune-prompt-overrides": "tsx scripts/prune-prompt-overrides.ts",
    "storage:audit": "tsx scripts/storage-audit.ts",
    "verify:editor-state": "tsx scripts/verify-editor-state-refs.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "assets:prune": "tsx scripts/prune-orphan-assets.ts",
    "oss:cors": "tsx scripts/oss-setup-cors.ts",
    "proxies:backfill": "tsx scripts/backfill-preview-proxies.ts",
    "local:prune": "tsx scripts/prune-local-after-migration.ts",
    "editor-state:repair": "tsx scripts/repair-editor-state-refs.ts",
    "files:prune": "tsx scripts/prune-orphan-files.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@base-ui/react": "^1.2.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/karla": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@google/genai": "^1.44.0",
    "@types/archiver": "^7.0.0",
    "@volcengine/openapi": "^1.36.1",
    "@webav/av-canvas": "^1.2.8",
    "@webav/av-cliper": "^1.2.8",
    "ai": "^6.0.116",
    "ali-oss": "^6.23.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "fluent-ffmpeg": "^2.1.3",
    "jsonrepair": "^3.12.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "undici": "^8.3.0",
    "unpdf": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^2.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
